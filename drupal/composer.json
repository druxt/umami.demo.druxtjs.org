{
    "name": "druxt/druxtjs-org-demo-umami",
    "description": "Drupal 9 JSON:API backend for Demonstration purposes.",
    "type": "project",
    "license": "GPL-2.0+",
    "repositories": [
        {
            "type": "composer",
            "url": "https://packages.drupal.org/8"
        }
    ],
    "require": {
        "amazeeio/drupal_integrations": "^0.5",
        "composer/installers": "^2.2",
        "cweagans/composer-patches": "^2.0@beta",
        "drupal/anonymous_redirect": "^2.5",
        "drupal/core-composer-scaffold": "~11",
        "drupal/core-project-message": "~11",
        "drupal/core-recommended": "~11",
        "drupal/decoupled_router": "2.0.5",
        "drupal/druxt": "^1.2.1",
        "drupal/gin": "^4.0",
        "drupal/gin_login": "^2.1",
        "drupal/gin_toolbar": "^2.0",
        "drupal/jsonapi_hypermedia": "^1.10",
        "drupal/jsonapi_menu_items": "^1.2",
        "drupal/jsonapi_node_preview": "^1.0@beta",
        "drupal/jsonapi_node_preview_tab": "^1.0",
        "drupal/lagoon_logs": "^3.0",
        "drupal/search_api_lunr": "^3.1",
        "drupal/simple_oauth": "^6.1",
        "drupal/tome": "^1.16",
        "drush/drush": "^13",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "drupal/core-dev": "~11",
        "weitzman/drupal-test-traits": "^2.6"
    },
    "autoload": {
        "files": [
            "load.environment.php"
        ]
    },
    "conflict": {
        "drupal/drupal": "*"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "test": [
            "phpunit --log-junit ./web/sites/simpletest/browser_output/junit.xml"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/installers": true,
            "cweagans/composer-patches": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "drupal/core-composer-scaffold": true,
            "drupal/core-project-message": true,
            "php-http/discovery": true,
            "phpstan/extension-installer": true,
            "symfony/runtime": true,
            "tbachert/spi": true,
            "zaporylie/composer-drupal-optimizations": true
        },
        "platform": {
            "php": "8.3"
        }
    },
    "extra": {
        "installer-paths": {
            "web/core": [
                "type:drupal-core"
            ],
            "web/libraries/{$name}": [
                "type:drupal-library"
            ],
            "web/modules/contrib/{$name}": [
                "type:drupal-module"
            ],
            "web/profiles/contrib/{$name}": [
                "type:drupal-profile"
            ],
            "web/themes/contrib/{$name}": [
                "type:drupal-theme"
            ],
            "drush/Commands/contrib/{$name}": [
                "type:drupal-drush"
            ],
            "web/modules/custom/{$name}": [
                "type:drupal-custom-module"
            ],
            "web/themes/custom/{$name}": [
                "type:drupal-custom-theme"
            ]
        },
        "drupal-scaffold": {
            "allowed-packages": [
                "amazeeio/drupal_integrations"
            ],
            "file-mapping": {
                "[web-root]/sites/default/all.settings.php": "assets/all.settings.php"
            },
            "locations": {
                "web-root": "web/"
            }
        },
        "patches": {
            "drupal/decoupled_router": {
                "https://www.drupal.org/project/decoupled_router/issues/3172926": "https://www.drupal.org/files/issues/2020-09-24/3172926-2.patch",
                "https://www.drupal.org/project/decoupled_router/issues/3468825": "https://git.drupalcode.org/project/decoupled_router/-/merge_requests/20.diff",
                "#3111456 Resolve the language from the requested path": "https://raw.githubusercontent.com/druxt/druxt.js/develop/docs/drupal/patches/decoupled_router-3111456-resolve-language-from-path.patch"
            },
            "drupal/druxt": {
                "#3273228 Add langcode to Views Decoupled Router integration (rerolled for 1.2.1)": "patches/druxt-3273228-views-route-langcode.patch",
                "#3264181 Node Preview (MR!8, rerolled for 1.2.1)": "patches/druxt-mr8-node-preview.patch"
            }
        }
    }
}
