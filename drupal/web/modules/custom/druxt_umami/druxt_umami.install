<?php

/**
 * @file
 * Install functions for the DruxtJS Umami module.
 */

use Drupal\consumers\Entity\Consumer;
use Drupal\contact\Entity\ContactForm;
use Drupal\Core\Field\Entity\BaseFieldOverride;
use Drupal\menu_link_content\Entity\MenuLinkContent;
use Drupal\user\RoleInterface;

/**
 * Implements hook_install().
 */
function druxt_umami_install() {
  // Enable Gin theme.
  \Drupal::service('theme_installer')->install(['gin']);
  \Drupal::service('config.factory')
    ->getEditable('system.theme')
    ->set('admin', 'gin')
    ->set('default', 'gin')
    ->save();

  // Anonymous redirect settings.
  \Drupal::service('config.factory')
    ->getEditable('anonymous_redirect.settings')
    ->set('enable_redirect', TRUE)
    ->set('redirect_url_overrides', "/en/user/*\n/jsonapi\n/jsonapi/*\n/js-search/*\n/oauth/*\n/router/*\n/user/*")
    ->save();

  // JSON:API settings.
  \Drupal::service('config.factory')->getEditable('jsonapi.settings')->set('read_only', FALSE)->save();

  // Remove the taxonomy term view displays druxt_install() auto-creates.
  //
  // druxt_ensure_entity_view_displays() creates one per bundle so DruxtSchema
  // always has a display to read. For a term that display holds only
  // `description`, because a term's name is its label and its path is not a
  // display component at all. DruxtEntity's schema-filtered query then asks
  // for terms without `name` or `path`, so a tag reference renders as an empty
  // badge linking to `/en` plus undefined, and every tag page stops being
  // linked and so stops being generated. A site with no term display has no
  // schema to filter by and works, which is why this never showed up before.
  //
  // Workaround, not a fix. The fix belongs upstream in the schema-filtered
  // query, which should always carry the entity's label and path.
  $displays = \Drupal::entityTypeManager()->getStorage('entity_view_display');
  foreach ($displays->loadByProperties(['targetEntityType' => 'taxonomy_term']) as $display) {
    $display->delete();
  }

  // Skip the two recipes the banner already shows.
  //
  // The promoted_items attachment and the frontpage grid both list promoted
  // recipes newest first. Since Drupal 11 (core #3399970) every demo node has
  // its own created date, so the grid's first two cards repeat the banner.
  $view = \Drupal::entityTypeManager()->getStorage('view')->load('frontpage');
  $display = &$view->getDisplay('default');
  $display['display_options']['pager']['options']['offset'] = 2;
  $view->save();

  // Card and teaser displays ship with an image and a title and nothing else,
  // so every card in the frontend renders as a bare headline: no category
  // kicker, no difficulty badge, no cooking time, no standfirst. The frontend
  // has a component per field for all of them. Put the fields on the displays
  // that feed the cards.
  $image = [
    'type' => 'entity_reference_entity_view',
    'label' => 'hidden',
    'settings' => ['view_mode' => 'medium_3_2_2x'],
    'weight' => -10,
  ];
  $displays = [
    'node.recipe.card' => [
      'field_media_image' => $image,
      'field_recipe_category' => ['type' => 'entity_reference_label', 'label' => 'hidden', 'settings' => ['link' => FALSE], 'weight' => -5],
      'field_difficulty' => ['type' => 'list_default', 'label' => 'hidden', 'weight' => 5],
      'field_cooking_time' => ['type' => 'number_integer', 'label' => 'hidden', 'weight' => 6],
    ],
    'node.article.card' => [
      'field_media_image' => $image,
      'field_tags' => ['type' => 'entity_reference_label', 'label' => 'hidden', 'settings' => ['link' => FALSE], 'weight' => -5],
      'field_body' => ['type' => 'text_summary_or_trimmed', 'label' => 'hidden', 'settings' => ['trim_length' => 130], 'weight' => 5],
    ],
    'node.recipe.teaser' => [
      'field_media_image' => $image,
    ],
  ];

  $storage = \Drupal::entityTypeManager()->getStorage('entity_view_display');
  foreach ($displays as $id => $components) {
    $display = $storage->load($id);
    if (!$display) {
      continue;
    }
    foreach ($components as $field => $options) {
      $display->setComponent($field, $options);
    }
    $display->save();
  }

  // The contact module ships the personal form only, and its site-wide form
  // setting points at a `feedback` form that no profile here creates, so
  // /contact fatals and every link to it is filtered out as inaccessible.
  if (!ContactForm::load('feedback')) {
    ContactForm::create([
      'id' => 'feedback',
      'label' => 'Website feedback',
      'recipients' => ['admin@example.com'],
      'message' => 'Your message has been sent.',
      'reply' => '',
      'weight' => 0,
    ])->save();
  }
  // The footer's base line, worded as the design has it.
  $blocks = \Drupal::entityTypeManager()
    ->getStorage('block_content')
    ->loadByProperties(['type' => 'disclaimer_block']);
  foreach ($blocks as $block) {
    $block->set('field_copyright', [
      'value' => '&copy; ' . date('Y') . ' Umami Publications &middot; Terms &amp; Conditions',
      'format' => 'basic_html',
    ])->save();
  }

  // The demo's contact form says no email is sent. Core's test collector
  // keeps each message in state instead of handing it to a mail server.
  \Drupal::configFactory()
    ->getEditable('system.mail')
    ->set('interface.default', 'test_mail_collector')
    ->save();
  user_role_grant_permissions(RoleInterface::ANONYMOUS_ID, ['access site-wide contact form']);
  user_role_grant_permissions(RoleInterface::AUTHENTICATED_ID, ['access site-wide contact form']);

  // DruxtEntityForm builds itself from the form display, and a form created
  // in code has none, so the contact page rendered as two bare buttons.
  $form_display = \Drupal::entityTypeManager()
    ->getStorage('entity_form_display')
    ->load('contact_message.feedback.default');
  if (!$form_display) {
    $form_display = \Drupal::entityTypeManager()
      ->getStorage('entity_form_display')
      ->create([
        'targetEntityType' => 'contact_message',
        'bundle' => 'feedback',
        'mode' => 'default',
        'status' => TRUE,
      ]);
    $weight = 0;
    foreach (['name' => 'string_textfield', 'mail' => 'email_default', 'subject' => 'string_textfield', 'message' => 'string_textarea', 'copy' => 'boolean_checkbox'] as $field => $type) {
      $form_display->setComponent($field, ['type' => $type, 'weight' => $weight++]);
    }
    $form_display->save();
  }

  // A visitor submitting an article through the demo should not be able to
  // publish it. The frontend's save button says "Save as unpublished", and
  // this is what makes that true.
  BaseFieldOverride::createFromBaseFieldDefinition(
    \Drupal::service('entity_field.manager')->getBaseFieldDefinitions('node')['status'],
    'article'
  )->setDefaultValue(FALSE)->save();

  // Every card on the site is the same card. The profile ships three view
  // modes for it (card, card_common, card_common_alt) which differ only in
  // which fields somebody remembered to enable, and each one needs its own
  // frontend component. Point the views that feed cards at `card`.
  $rows = [
    'frontpage' => ['default'],
    'featured_articles' => ['default'],
    'articles_aside' => ['default'],
  ];
  foreach ($rows as $view_id => $display_ids) {
    $view = \Drupal::entityTypeManager()->getStorage('view')->load($view_id);
    if (!$view) {
      continue;
    }
    $display = $view->get('display');
    foreach ($display_ids as $display_id) {
      if (isset($display[$display_id]['display_options']['row']['options']['view_mode'])) {
        $display[$display_id]['display_options']['row']['options']['view_mode'] = 'card';
      }
    }
    $view->set('display', $display)->save();
  }

  // Menu links for the pages the frontend already renders.
  //
  // demo_umami ships the About page and the contact form, but links to
  // neither: the main menu is three view routes and the footer menu is empty,
  // so the footer's Magazine column had nothing to list.
  $links = [
    // Articles is 20 and Recipes is 30 in the view's own menu settings, so
    // these two sit after them.
    ['title' => 'About', 'uri' => 'internal:/about-umami', 'menu' => 'main', 'weight' => 40],
    ['title' => 'Contact', 'uri' => 'internal:/contact', 'menu' => 'main', 'weight' => 41],
    ['title' => 'Home', 'uri' => 'internal:/', 'menu' => 'footer', 'weight' => 0],
    ['title' => 'Articles', 'uri' => 'internal:/articles', 'menu' => 'footer', 'weight' => 1],
    ['title' => 'Recipes', 'uri' => 'internal:/recipes', 'menu' => 'footer', 'weight' => 2],
    ['title' => 'About', 'uri' => 'internal:/about-umami', 'menu' => 'footer', 'weight' => 3],
    ['title' => 'Contact', 'uri' => 'internal:/contact', 'menu' => 'footer', 'weight' => 4],
  ];
  foreach ($links as $link) {
    MenuLinkContent::create([
      'title' => $link['title'],
      'link' => ['uri' => $link['uri']],
      'menu_name' => $link['menu'],
      'weight' => $link['weight'],
      'expanded' => TRUE,
    ])->save();
  }

  // Druxt JSON:API resource access.
  // druxt_entity_access() gates view--view, menu--menu and the display config
  // the frontend builds its components from on this permission, so without it
  // an anonymous DruxtView cannot read the view it is rendering.
  foreach ([RoleInterface::ANONYMOUS_ID, RoleInterface::AUTHENTICATED_ID] as $role_id) {
    user_role_grant_permissions($role_id, ['access druxt resources']);
  }

  // Simple Oauth settings.
  \Drupal::service('config.factory')
    ->getEditable('simple_oauth.settings')
    ->set('public_key', '../keys/public.key')
    ->set('private_key', '../keys/private.key')
    ->set('use_implicit', TRUE)
    ->save();

  // Create consumer client.
  // Simple OAuth 6 resolves the client by the consumer's client_id field, not
  // by its uuid the way Simple OAuth 5 did. An empty client_id matches nothing
  // and every token request answers invalid_client.
  $client_id = getenv('OAUTH_CLIENT_ID') ?: \Drupal::service('uuid')->generate();
  $consumer = Consumer::create([
    'owner_id'     => 1,
    'uuid'         => $client_id,
    'client_id'    => $client_id,
    'label'        => 'Druxt',
    'description'  => "DruxtJS is a bridge between frameworks, Drupal in the back, Nuxt in the front.\n\nhttps://druxtjs.org",
    'confidential' => FALSE,
    'pkce'         => TRUE,
    // Simple OAuth 6 gates every grant on this field, and an empty one means
    // the token endpoint answers invalid_client for all of them. The frontend
    // uses the authorization code flow with a refresh token; the password
    // grant no longer exists in Simple OAuth 6.
    'grant_types'  => ['authorization_code', 'refresh_token'],
    'redirect'     => getenv('OAUTH_CALLBACK') ?: 'http://localhost:3000/callback',
    'image_styles' => [],
  ]);
  $consumer->save();
}
